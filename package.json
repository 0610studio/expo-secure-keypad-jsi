{
  "name": "expo-secure-keypad-jsi",
  "version": "0.1.3",
  "description": "Secure PIN / password keypad for Expo (New Architecture). Natively rendered shuffled keys, the entered value never enters the JS runtime, mlock'd C++ buffer, OpenSSL RSA-OAEP ciphertext only. Screen-capture blocking and device integrity are the host app's job.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "android/build.gradle",
    "android/CMakeLists.txt",
    "android/src/main",
    "ios",
    "common",
    "expo-module.config.json",
    "SecureKeypadJsi.podspec",
    "README.md",
    "docs/README.ko.md",
    "docs/BUILD.md",
    "docs/BUILD.ko.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf build",
    "lint": "eslint src/",
    "test": "jest",
    "test:cpp": "cmake -S tests/cpp -B build-cpp -DCMAKE_BUILD_TYPE=Debug && cmake --build build-cpp && ctest --test-dir build-cpp --output-on-failure",
    "prepare": "rm -rf build && tsc",
    "example:android": "cd example && CI=1 npx expo prebuild --platform android --no-install && npx expo run:android",
    "example:ios": "cd example && CI=1 npx expo prebuild --platform ios --no-install && npx expo run:ios"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-secure-keypad-jsi",
    "SecureKeypadJsi"
  ],
  "repository": "https://github.com/0610studio/expo-secure-keypad-jsi",
  "bugs": {
    "url": "https://github.com/0610studio/expo-secure-keypad-jsi/issues"
  },
  "author": "0610studio <0610studio@naver.com> (https://github.com/0610studio)",
  "license": "MIT",
  "homepage": "https://github.com/0610studio/expo-secure-keypad-jsi#readme",
  "packageManager": "pnpm@10.16.1",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-preset-expo": "~57.0.7",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "^57.0.15",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "prettier": "^3.0.0",
    "react-native": "0.86.2",
    "react-test-renderer": "^19.2.0",
    "typescript": "^5.9.2"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "roots": [
      "<rootDir>/src"
    ],
    "transform": {
      "^.+\\.(t|j)sx?$": [
        "babel-jest",
        { "presets": ["babel-preset-expo"] }
      ]
    }
  },
  "peerDependencies": {
    "expo": ">=54.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.81.0"
  }
}
